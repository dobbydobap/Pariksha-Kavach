# Free tier, no credit card. https://console.groq.com
# Models: llama-3.3-70b-versatile, qwen/qwen3-32b, moonshotai/kimi-k2-instruct
GROQ_API_KEY=gsk_...

# Free tier, Google account only. https://aistudio.google.com/apikey
# Models: gemini-2.5-flash-lite, gemini-2.5-flash
GOOGLE_API_KEY=AIza...

# Optional. Written and ready, but unfunded; the Claude column is reported
# as not measured until this is set. See D-031.
ANTHROPIC_API_KEY=

# Optional. Razorpay TEST MODE only; refuses to start on an rzp_live_ key.
# Used for the conformance proof, not for the benchmark itself.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
